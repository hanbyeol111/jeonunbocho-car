<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱의 기본 버튼: 흰 바탕 -->
    <style name="Jb.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/jb_surface</item>
        <item name="android:textColor">@color/jb_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 화면마다 하나만 쓰는 핵심 버튼 -->
    <style name="Jb.Button.Primary">
        <item name="backgroundTint">@color/jb_primary</item>
        <item name="android:textColor">@color/jb_on_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- 둘 중 하나를 고르는 큰 버튼 -->
    <style name="Jb.Button.Choice">
        <item name="backgroundTint">@color/jb_toggle_background</item>
        <item name="android:textColor">@color/jb_toggle_text</item>
        <item name="android:textSize">24sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:checkable">true</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">44dp</item>
        <item name="iconTint">@color/jb_toggle_icon</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- 화면 왼쪽 위 뒤로 버튼: 흰 알약 -->
    <style name="Jb.Button.Back">
        <item name="cornerRadius">32dp</item>
        <item name="icon">@drawable/ic_chevron_left</item>
        <item name="iconTint">@color/jb_text</item>
        <item name="iconPadding">6dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- 홈 메뉴 색 타일 -->
    <style name="Jb.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">7dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Jb.TileBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">24dp</item>
    </style>

    <style name="Jb.TileIcon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/jb_on_block</item>
    </style>

    <style name="Jb.TileTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jb_on_block</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Jb.TileDesc" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/jb_on_block_secondary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- 남는 세로 공간 채우기 -->
    <style name="Jb.Fill" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- 화면 맨 위 제목 -->
    <style name="Jb.HeaderTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 카드 안의 작은 제목 -->
    <style name="Jb.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jb_text_secondary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 회전 횟수 칸 -->
    <style name="Jb.Stat" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_block</item>
        <item name="android:backgroundTint">@color/jb_background</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="Jb.StatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 색 블록 위 글자: 다크에서도 어둡게 -->
    <style name="Jb.OnBlock" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jb_on_block</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
