<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱의 기본 버튼 -->
    <style name="Jb.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/jb_card</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 화면마다 하나만 쓰는 핵심 버튼 -->
    <style name="Jb.Button.Primary">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/jb_navy</item>
    </style>

    <!-- 둘 중 하나를 고르는 버튼 -->
    <style name="Jb.Button.Toggle">
        <item name="backgroundTint">@color/jb_toggle_background</item>
        <item name="android:textColor">@color/jb_toggle_text</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>