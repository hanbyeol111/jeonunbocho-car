<?xml version="1.0" encoding="utf-8"?>
<!-- 주행 중 설정 화면 위에 까는 투명한 판. 화면은 그대로 보이고 터치만 받는다.
     터치하면 아래 안내가 잠깐 떴다가 사라진다(전체 화면 팝업은 쓰지 않는다). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drivingBlock"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="주행 중에는 코스를 고를 수 없어요"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/drivingNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="32dp"
        android:alpha="0"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_butter"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <TextView
            style="@style/Jb.OnBlock"
            android:text="주행 중에는 사용할 수 없어요"
            android:textSize="32sp" />

        <TextView
            style="@style/Jb.OnBlock"
            android:layout_marginTop="8dp"
            android:text="차를 세우면 다시 쓸 수 있어요"
            android:textColor="@color/jb_on_block_secondary"
            android:textSize="24sp"
            android:textStyle="normal" />
    </LinearLayout>
</FrameLayout>
