<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Jb.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:text="뒤로" />

        <TextView
            style="@style/Jb.HeaderTitle"
            android:text="순환 코스" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_mint"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    style="@style/Jb.OnBlock"
                    android:text="얼마나 달릴까요?" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/distanceText"
                        style="@style/Jb.OnBlock"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.05"
                        android:textSize="136sp" />

                    <TextView
                        style="@style/Jb.OnBlock"
                        android:layout_marginStart="8dp"
                        android:text="km"
                        android:textSize="40sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/distanceSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:contentDescription="순환 코스 거리"
                    android:stepSize="0.1"
                    android:value="5.0"
                    android:valueFrom="1.0"
                    android:valueTo="50.0"
                    app:haloRadius="0dp"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/jb_on_block"
                    app:thumbRadius="22dp"
                    app:thumbStrokeColor="@color/white"
                    app:thumbStrokeWidth="6dp"
                    app:trackColorActive="@color/jb_on_block"
                    app:trackColorInactive="@color/white"
                    app:trackHeight="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Jb.OnBlock"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="1km" />

                    <TextView
                        style="@style/Jb.OnBlock"
                        android:text="50km" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Jb.Label"
                android:layout_marginTop="24dp"
                android:text="어느 방향으로 돌까요?" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClockwise"
                    style="@style/Jb.Button.Choice"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:text="시계 방향\n오른쪽으로 크게 돌아요"
                    app:icon="@drawable/ic_rotate_cw" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCounterClockwise"
                    style="@style/Jb.Button.Choice"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:text="반시계 방향\n왼쪽으로 크게 돌아요"
                    app:icon="@drawable/ic_rotate_ccw" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnNext"
        style="@style/Jb.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:text="코스 만들기" />
</LinearLayout>
