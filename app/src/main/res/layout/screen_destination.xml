<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Jb.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:text="뒤로" />

        <TextView
            style="@style/Jb.HeaderTitle"
            android:text="목적지 안내" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_butter"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            style="@style/Jb.OnBlock"
            android:text="즐겨찾기 · 최근 목적지"
            android:textSize="30sp" />

        <TextView
            style="@style/Jb.OnBlock"
            android:layout_marginTop="6dp"
            android:text="목록은 준비 중이에요"
            android:textColor="@color/jb_on_block_secondary"
            android:textStyle="normal" />
    </LinearLayout>

    <Space style="@style/Jb.Fill" />

    <Button
        android:id="@+id/btnNext"
        style="@style/Jb.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:text="기본 내비에서 검색" />
</LinearLayout>
