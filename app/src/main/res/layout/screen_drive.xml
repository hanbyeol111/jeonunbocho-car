<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/driveCourse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="연습 중"
        android:textColor="@color/jb_text_secondary"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_level_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="40dp">

        <TextView
            android:id="@+id/nextDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="96sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nextPoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="안내를 기다리는 중"
            android:textSize="44sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnArrive"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:text="도착 (임시)" />
</LinearLayout>
