<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/driveCourse"
        style="@style/Jb.Label"
        android:text="연습 중" />

    <!-- 연습 상황이 멀 때: 다음 연습과 거리만 -->
    <LinearLayout
        android:id="@+id/practiceFar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_ink"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 연습"
            android:textColor="@color/jb_on_ink_secondary"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/farTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="안내를 기다리는 중"
                android:textColor="@color/jb_lime"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/farDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/jb_on_ink"
                android:textSize="60sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 연습 상황이 가까울 때: 큰 거리와 할 일 코칭 -->
    <LinearLayout
        android:id="@+id/practiceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_lime"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nearCourse"
            style="@style/Jb.OnBlock" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nextDistance"
                style="@style/Jb.OnBlock"
                android:includeFontPadding="false"
                android:letterSpacing="-0.06"
                android:textSize="200sp" />

            <TextView
                android:id="@+id/nextUnit"
                style="@style/Jb.OnBlock"
                android:layout_marginStart="8dp"
                android:textSize="64sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextPoint"
            style="@style/Jb.OnBlock"
            android:layout_marginBottom="12dp"
            android:textSize="60sp" />

        <LinearLayout
            android:id="@+id/coachRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <Space style="@style/Jb.Fill" />

    <LinearLayout
        android:id="@+id/lanePrepCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_sky"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <TextView
            style="@style/Jb.OnBlock"
            android:text="차선 준비" />

        <TextView
            android:id="@+id/lanePrepTurn"
            style="@style/Jb.OnBlock"
            android:layout_marginTop="6dp"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/lanePrepAdvice"
            style="@style/Jb.OnBlock"
            android:textSize="24sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnArrive"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="14dp"
        android:text="도착 (임시)"
        android:textColor="@color/jb_text_secondary" />
</LinearLayout>
