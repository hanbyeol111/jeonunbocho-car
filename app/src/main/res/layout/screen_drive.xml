<?xml version="1.0" encoding="utf-8"?>
<!-- 크기는 시안 C 캔버스(600×800dp) 기준. 창이 더 크면 MainActivity가 같은 비율로 키운다.
     세로 예산: 736dp = 머리줄 + 카드 영역(스크롤) + 코스 진행 + 주행 끝내기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/driveCourse"
        style="@style/Jb.Label"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="연습 중" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 멀 때 맨 위: 지금 할 일 = 다음 회전과 차선 준비 (세로 약 343dp) -->
            <LinearLayout
                android:id="@+id/nowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_sky"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Jb.OnBlock"
                    android:text="지금 할 일" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/nowIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        app:tint="@color/jb_on_block" />

                    <TextView
                        android:id="@+id/nowDistance"
                        style="@style/Jb.OnBlock"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.05"
                        android:textSize="80sp" />

                    <TextView
                        android:id="@+id/nowUnit"
                        style="@style/Jb.OnBlock"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="6dp"
                        android:textSize="34sp" />
                </LinearLayout>

                <!-- 회전 이름 옆에 내비가 주는 방면 글자. 없으면 숨긴다. 한 줄에 둬서 높이를 아낀다. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nowTurn"
                        style="@style/Jb.OnBlock"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/nowSign"
                        style="@style/Jb.OnBlock"
                        android:layout_width="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/jb_on_block_secondary"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nowAdvice"
                    style="@style/Jb.OnBlock"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_tag"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="24sp" />

                <!-- 회전이 연달아 올 때: 차선 준비 대신 이 칸을 보여 준다. -->
                <LinearLayout
                    android:id="@+id/followCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_tag"
                    android:backgroundTint="@color/jb_on_block"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="바로 이어서"
                        android:textColor="@color/jb_lime"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/followIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/followTurn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/followAdvice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 멀 때 둘째: 다음 연습 상황. 참고 정보라 작게 둔다 (세로 약 100dp) -->
            <LinearLayout
                android:id="@+id/practiceFar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_ink"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다음 연습"
                    android:textColor="@color/jb_on_ink_secondary"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/farIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        app:tint="@color/jb_lime" />

                    <TextView
                        android:id="@+id/farTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="안내를 기다리는 중"
                        android:textColor="@color/jb_lime"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/farDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textColor="@color/jb_on_ink"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 가까울 때: 지금 할 일 = 연습 상황 코칭, 지금 단계 한 줄 (세로 약 488dp) -->
            <LinearLayout
                android:id="@+id/practiceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_lime"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    style="@style/Jb.OnBlock"
                    android:text="지금 할 일 · 연습 상황" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/nextIcon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        app:tint="@color/jb_on_block" />

                    <TextView
                        android:id="@+id/nextDistance"
                        style="@style/Jb.OnBlock"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.06"
                        android:textSize="128sp" />

                    <TextView
                        android:id="@+id/nextUnit"
                        style="@style/Jb.OnBlock"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="8dp"
                        android:textSize="48sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nextPoint"
                    style="@style/Jb.OnBlock"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/nextSign"
                    style="@style/Jb.OnBlock"
                    android:textColor="@color/jb_on_block_secondary"
                    android:visibility="gone" />

                <!-- 단계 막대(준비·확인·실행). 칸 수는 상황마다 다르다. -->
                <LinearLayout
                    android:id="@+id/stageSteps"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/stageLabel"
                    style="@style/Jb.OnBlock"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/stageText"
                    style="@style/Jb.OnBlock"
                    android:layout_width="match_parent"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_block"
                    android:backgroundTint="@color/jb_surface"
                    android:minHeight="74dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/jb_text"
                    android:textSize="28sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 코스 진행: 두 상태 모두 아래에 고정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_surface"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Jb.Label"
                android:text="코스 진행"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:text="경로 정보를 기다리는 중"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/courseProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            app:indicatorColor="@color/jb_primary"
            app:trackColor="@color/jb_background"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnArrive"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="14dp"
        android:text="주행 끝내기"
        android:textColor="@color/jb_text_secondary" />
</LinearLayout>
