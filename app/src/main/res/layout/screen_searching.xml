<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Jb.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="취소"
            app:icon="@null" />

        <TextView
            style="@style/Jb.HeaderTitle"
            android:text="길 찾기" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:background="@drawable/bg_block"
        android:backgroundTint="@color/jb_lime"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/searchTitle"
            style="@style/Jb.OnBlock"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textSize="24sp" />

        <!-- 몇 번째 후보인지. 위치를 받기 전에는 숨긴다. -->
        <LinearLayout
            android:id="@+id/searchAttemptLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/searchAttempt"
                style="@style/Jb.OnBlock"
                android:includeFontPadding="false"
                android:letterSpacing="-0.06"
                android:textSize="180sp" />

            <TextView
                android:id="@+id/searchTotal"
                style="@style/Jb.OnBlock"
                android:textSize="72sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchProgress"
            style="@style/Jb.OnBlock"
            android:layout_marginTop="16dp"
            android:textSize="30sp" />

        <!-- 맞는 길이 없을 때 고른 후보의 요약 -->
        <TextView
            android:id="@+id/searchPick"
            style="@style/Jb.OnBlock"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textSize="26sp"
            android:visibility="gone" />

        <!-- 찾는 동안은 진행 막대, 다 찾은 뒤 맞는 길이 없으면 번호 칸(눌러서 후보 보기)으로 바뀐다 -->
        <LinearLayout
            android:id="@+id/searchSteps"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPick"
        style="@style/Jb.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:text="이 코스로 하기"
        android:visibility="gone" />

    <TextView
        style="@style/Jb.Label"
        android:layout_marginTop="18dp"
        android:text="기본 내비에 후보 경로가 뜨면 '안내 시작'을 눌러 주세요. 번호를 누르면 앞서 본 코스를 다시 볼 수 있어요" />
</LinearLayout>
