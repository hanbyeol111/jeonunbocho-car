<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Jb.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:text="뒤로" />

        <TextView
            style="@style/Jb.HeaderTitle"
            android:text="코스 확인" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 이번 연습: 코스 이름과 실제 거리·시간 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_sky"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    style="@style/Jb.OnBlock"
                    android:text="이번 연습" />

                <TextView
                    android:id="@+id/courseInfo"
                    style="@style/Jb.OnBlock"
                    android:layout_marginTop="4dp"
                    android:textSize="40sp" />

                <LinearLayout
                    android:id="@+id/routeLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_block"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp">

                        <TextView
                            style="@style/Jb.OnBlock"
                            android:text="실제 거리"
                            android:textColor="@color/jb_on_block_secondary" />

                        <TextView
                            android:id="@+id/routeDistance"
                            style="@style/Jb.OnBlock"
                            android:textSize="44sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_block"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp">

                        <TextView
                            style="@style/Jb.OnBlock"
                            android:text="예상 시간"
                            android:textColor="@color/jb_on_block_secondary" />

                        <TextView
                            android:id="@+id/routeTime"
                            style="@style/Jb.OnBlock"
                            android:textSize="44sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/routeNote"
                    style="@style/Jb.OnBlock"
                    android:layout_marginTop="16dp"
                    android:text="출발한 곳으로 다시 돌아와요"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 이 코스에서 하게 될 것 -->
            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_surface"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    style="@style/Jb.Label"
                    android:text="이 코스에서 하게 될 것" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/Jb.Stat">

                        <TextView
                            android:id="@+id/statRight"
                            style="@style/Jb.StatValue" />

                        <TextView
                            style="@style/Jb.Label"
                            android:text="우회전" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Jb.Stat"
                        android:layout_marginHorizontal="12dp">

                        <TextView
                            android:id="@+id/statLeft"
                            style="@style/Jb.StatValue" />

                        <TextView
                            style="@style/Jb.Label"
                            android:text="좌회전" />
                    </LinearLayout>

                    <LinearLayout style="@style/Jb.Stat">

                        <TextView
                            android:id="@+id/statUturn"
                            style="@style/Jb.StatValue" />

                        <TextView
                            style="@style/Jb.Label"
                            android:text="유턴" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Jb.Label"
                    android:layout_marginTop="20dp"
                    android:text="연습 상황" />

                <TextView
                    android:id="@+id/routeSituations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/routeFirstGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jb.Label"
                        android:layout_marginTop="20dp"
                        android:text="출발하면 먼저" />

                    <TextView
                        android:id="@+id/routeFirst"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/routeFirstAdvice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- 출발 전 브리핑: 회전이 연달아 오는 곳. 없으면 숨긴다. -->
                <LinearLayout
                    android:id="@+id/tightGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Jb.Label"
                        android:layout_marginTop="20dp"
                        android:text="미리 알아 둘 구간 · 회전이 연달아 와요" />

                    <LinearLayout
                        android:id="@+id/tightRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tightMore"
                        style="@style/Jb.Label"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 완주하면 받을 수 있는 포인트 -->
            <LinearLayout
                android:id="@+id/pointsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_lime"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="22dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bestTotal"
                        style="@style/Jb.OnBlock"
                        android:textSize="48sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Jb.OnBlock"
                            android:text="완주하면 최대"
                            android:textSize="24sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pointRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnStart"
        style="@style/Jb.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:text="출발" />
</LinearLayout>
