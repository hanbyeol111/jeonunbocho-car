<?xml version="1.0" encoding="utf-8"?>
<!-- 출발 전 확인. 정차 중에만 보는 화면이라 주행 중 설정 제한 때는 다른 설정 화면처럼 막힌다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Jb.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:text="뒤로" />

        <TextView
            style="@style/Jb.HeaderTitle"
            android:text="출발 전 확인" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1">

        <!-- 항목은 코드(CheckItem)에서 item_check로 채운다 -->
        <LinearLayout
            android:id="@+id/checkRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_block"
            android:backgroundTint="@color/jb_surface"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="6dp" />
    </ScrollView>

    <Button
        android:id="@+id/btnGo"
        style="@style/Jb.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:text="다 확인했어요, 출발" />
</LinearLayout>
