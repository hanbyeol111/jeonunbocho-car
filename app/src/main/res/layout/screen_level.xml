<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Jb.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:text="뒤로" />

        <TextView
            style="@style/Jb.HeaderTitle"
            android:text="난이도별 코스" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 레벨 진행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_ink"
                android:orientation="vertical"
                android:paddingHorizontal="26dp"
                android:paddingVertical="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/levelValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/jb_lime"
                        android:textSize="56sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/levelPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/jb_on_ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/levelProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    app:indicatorColor="@color/jb_lime"
                    app:trackColor="@color/jb_ink_track"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="10dp" />

                <TextView
                    android:id="@+id/levelHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/jb_on_ink_secondary"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- 이번 코스 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_sky"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/courseLabel"
                    style="@style/Jb.OnBlock" />

                <TextView
                    android:id="@+id/courseDistance"
                    style="@style/Jb.OnBlock"
                    android:layout_marginTop="4dp"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/courseElements"
                    style="@style/Jb.OnBlock"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/courseOption"
                        style="@style/Jb.OnBlock"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />

                    <TextView
                        android:id="@+id/courseDirection"
                        style="@style/Jb.OnBlock"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 완주하면 받을 수 있는 포인트 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_lime"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="22dp">

                <TextView
                    style="@style/Jb.OnBlock"
                    android:text="완주하면 받을 수 있는 포인트" />

                <LinearLayout
                    android:id="@+id/pointRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 레벨 지도 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_block"
                android:backgroundTint="@color/jb_surface"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/Jb.Label"
                    android:text="레벨 지도" />

                <LinearLayout
                    android:id="@+id/levelRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnMoreLevels"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:text="모든 레벨 보기"
                    app:backgroundTint="@color/jb_background" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnNext"
        style="@style/Jb.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp" />
</LinearLayout>
