<?xml version="1.0" encoding="utf-8"?>
<!-- 출발 전 확인 한 항목: 체크박스 + 제목·설명 + 차량에서 읽은 상태(있을 때만) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="14dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkBox"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:buttonTint="@color/jb_text"
        android:scaleX="1.4"
        android:scaleY="1.4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/checkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jb_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/checkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/jb_text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/checkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/jb_on_block"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
